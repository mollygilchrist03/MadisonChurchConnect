@model MadisonChurchConnect.Models.ViewModels.AllSermonsPageViewModel

@{
    ViewData["Title"] = "Sermons";
}

<div class="sermons-page">
    <!-- Watch Sermons Section -->
    <div class="sermon-info-card">
        <h2>Welcome!</h2>
        <p>
            Join us for worship this Sunday at 10:30am as we continue our
            <strong>@Model.CurrentSeriesName</strong> series!
        </p>
        <p>
            Watch past messages below or visit our YouTube channel for more!
        </p>
        <a href="https://www.youtube.com/@@madisonchurchphx/videos" target="_blank" class="sermon-watch-button">
            Watch on Youtube
        </a>
    </div>

    <!-- Recent Sermons Grid -->
    <h2 class="section-heading">Watch Latest Messages</h2>
    <div class="recent-sermons">

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning" role="alert">
                @Model.ErrorMessage
            </div>
        }
        else if (Model.Series.Any())
        {
            <div class="sermon-grid">
                @foreach (var series in Model.Series)
                {
                    var latestVideo = series.Videos.OrderBy(video => video.PublishedAt).LastOrDefault();
                    var seriesTitle = !string.IsNullOrWhiteSpace(series.SeriesName)
                        ? series.SeriesName
                        : latestVideo?.Title ?? "Untitled Series";

                    <a asp-controller="Sermons"
                       asp-action="SeriesDetails"
                       asp-route-playlistId="@series.PlaylistId"
                       class="sermon-card"
                       title="View @seriesTitle series">
                        @if (latestVideo != null && !string.IsNullOrWhiteSpace(latestVideo.ThumbnailUrl))
                        {
                            <img src="@latestVideo.ThumbnailUrl" alt="@seriesTitle" class="sermon-image" />
                        }
                        <div class="sermon-card-content">
                            <h3>@seriesTitle</h3>
                            <p>@series.Videos.Count sermon@(series.Videos.Count == 1 ? string.Empty : "s")</p>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No recent sermon series found.
            </div>
        }

        <a asp-area="" asp-controller="Sermons" asp-action="AllSermons" class="all-sermons-btn">
            View All Sermons
        </a>
    </div>

    <!-- Pastor's Note -->
    <div class="sermon-info-card pastor-note">
        <h3>A Note From Our Pastor</h3>
        <p class="pastor-name">PASTOR BRYAN</p>
        <p>
            Hey there! Thank you for stopping by our app. If you are searching for a home church,
            we would love for you to give us a chance. Feel free to check out the "I'm New" button
            under the Connect tab where you can find the answers to all your questions. If you have never been
            to our church before, come by this Sunday! We would love to get to know you. We want to see
            lives changed here by the power of Jesus Christ, and we see that happen every week when
            someone steps through our doors. We look forward to meeting you! God bless.
        </p>
        <a href="https://madisonphx.org/visit/" class="sermon-visit-button">Plan Your Visit</a>
    </div>
</div>
