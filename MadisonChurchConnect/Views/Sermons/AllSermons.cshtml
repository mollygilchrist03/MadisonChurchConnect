@model MadisonChurchConnect.Models.ViewModels.AllSermonsPageViewModel

@{
    ViewData["Title"] = "All Sermons";
}

<div class="all-sermons">
    <div class="all-sermons-header">
        <h1>All Sermons</h1>
        <p>Browse sermon series, then open a series to see all messages in chronological order.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Series.Any())
    {
        <div class="all-sermons-grid">
            @foreach (var series in Model.Series)
            {
                var latestVideo = series.Videos.OrderBy(video => video.PublishedAt).LastOrDefault();

                <a asp-controller="Sermons"
                   asp-action="SeriesDetails"
                   asp-route-playlistId="@series.PlaylistId"
                   class="series-card"
                   title="View @series.SeriesName series">
                    @if (latestVideo != null && !string.IsNullOrWhiteSpace(latestVideo.ThumbnailUrl))
                    {
                        <img src="@latestVideo.ThumbnailUrl" alt="@series.SeriesName" class="sermon-image" />
                    }
                    <div class="series-card-content">
                        <h2>@series.SeriesName</h2>
                        <p>@series.Videos.Count sermon@(series.Videos.Count == 1 ? string.Empty : "s")</p>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No sermons found.
        </div>
    }
</div>
