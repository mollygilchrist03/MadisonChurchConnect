@{
    ViewData["Title"] = "Connect";
}

<div class="connect-page">
    <!-- church info card-->
    <div class="church-info">
        <h2>Madison Church</h2>
        <p>
            <img src="~/images/location-dot-solid-full.svg" alt="Map Pin" />
            6202 N 12th St, Phoenix, AZ 85014
        </p>

        <p>
            <img src="~/images/church-solid-full.svg" alt="Church" />
            Sunday Mornings at 10:30am
        </p>

        <div class="church-phone">
            <img src="~/images/phone-solid-full.svg" alt="Phone" />
            <a href="tel:6022771720" target="_blank" rel="noopener noreferrer">(602) 277-1720</a>
        </div>

        <a class="map-button" href="https://www.google.com/maps?q=6202+N+12th+St+Phoenix+AZ+85014" target="_blank" rel="noopener noreferrer">
            Get Directions
        </a>
    </div>

    <!-- connect buttons-->
    <div class="connect-actions">
        <a class="connect-btn prayer" href="https://dashboard.faithteams.com/forms/xXLED">
            <img src="~/images/hands-praying-solid-full.svg" alt="Praying Hands" />
            Prayer Requests
        </a>
        <a class="connect-btn new" href="https://dashboard.faithteams.com/forms/Mn5IJ">
            <img src="~/images/hand-solid-full.svg" alt="Hand" />
            I'm New
        </a>
        <a class="connect-btn steps" href="https://dashboard.faithteams.com/forms/uiVF6">
            <img src="~/images/shoe-prints-solid-full.svg" alt="Steps" />
            Next Steps
        </a>
        <a class="connect-btn contact" href="https://madisonphx.org/contact-us/">
            <img src="~/images/id-badge-regular-full.svg" alt="Contact" />
            Contact Us
        </a>
    </div>

    <!-- social links -->
    <div class="social-links">
        <a class="social-links-btn website" href="https://madisonphx.org/">
            <img src="~/images/globe-solid-full.svg" alt="Globe" />
            Visit Website
        </a>
        <a class="social-links-btn facebook" href="https://www.facebook.com/media/set/?vanity=madisonphx.org&set=a.573333544823016" target="_blank" rel="noopener noreferrer"> 
            <img src="~/images/facebook-brands-solid-full.svg" alt="Facebook Logo" />
            Facebook
        </a>
        <a class="social-links-btn youtube" href="https://www.youtube.com/@@madisonchurchphx/featured" target="_blank" rel="noopener noreferrer">
            <img src="~/images/youtube-brands-solid-full.svg" alt="YouTube Logo" />
            YouTube
        </a>
        <a class="social-links-btn instagram" href="https://www.instagram.com/madisonchurchphx/" target="_blank" rel="noopener noreferrer">
            <img src="~/images/instagram-brands-solid-full.svg" alt="Instagram Logo" />
            Instagram
        </a>
    </div>
</div>