        <a class="connect-btn new" href="https://dashboard.faithteams.com/forms/Mn5IJ"
           target="_blank">I'm New</a>
        <a class="connect-btn steps" href="https://dashboard.faithteams.com/forms/uiVF6"
           target="_blank">Next Steps</a>
        <a class="connect-btn website" href="https://madisonphx.org/"
           target="_blank">Visit Website</a>
    </div>

    <!-- social links -->
    <div class="social-links">
        <a class="social-links-btn facebook" href="https://www.facebook.com/media/set/?vanity=madisonphx.org&set=a.573333544823016"
           target="_blank">
           Facebook
       </a>
        <a class="social-links-btn youtube" href="https://www.youtube.com/@@madisonchurchphx/featured"
           target="_blank">
           YouTube
       </a>
        <a class="social-links-btn instagram" href="https://www.instagram.com/madisonchurchphx/"
           target="_blank">
           Instagram
       </a>
    </div>
</div>