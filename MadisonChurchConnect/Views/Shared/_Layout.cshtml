<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Madison Church Connect</title>
    <meta name="description" content="Madison Church Connect is a Progressive Web App for sermons, events, notes, giving, and church connection resources." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MadisonChurchConnect.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="/m-logo-new-white.ico">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4267B2">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Madison Connect">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <script>
        (function () {
            const themeStorageKey = 'madison-connect-theme';
            const darkThemeName = 'dark';
            const lightThemeName = 'light';

            function getStoredTheme() {
                try {
                    return window.localStorage.getItem(themeStorageKey);
                } catch {
                    return null;
                }
            }

            const storedTheme = getStoredTheme();
            const preferredTheme = storedTheme === darkThemeName || storedTheme === lightThemeName
                ? storedTheme
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? darkThemeName : lightThemeName);

            document.documentElement.setAttribute('data-theme', preferredTheme);
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div id="app-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

    <header>
        <nav class="navbar navbar-dark top-icon-bar" aria-label="Primary header">
            <div class="container-fluid">
                <div class="top-nav-left">
                    <a class="navbar-brand" asp-area="" asp-controller="Sermons" asp-action="Index" aria-label="Madison Church home">
                        <img src="~/images/m-logo-new-white.png" alt="Madison Church logo" height="40" width="40" />
                    </a>
                    <span class="top-nav-text">Madison Church</span>
                </div>
                <a class="more-icon-link" asp-area="" asp-controller="Menu" asp-action="Index" aria-label="Open menu and account options">
                    <svg class="more-icon" style="fill: #ffffff;" viewBox="0 0 640 640" aria-hidden="true" focusable="false">
                        <path style="fill: #ffffff;" d="M463 448.2C440.9 409.8 399.4 384 352 384L288 384C240.6 384 199.1 409.8 177 448.2C212.2 487.4 263.2 512 320 512C376.8 512 427.8 487.3 463 448.2zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM320 336C359.8 336 392 303.8 392 264C392 224.2 359.8 192 320 192C280.2 192 248 224.2 248 264C248 303.8 280.2 336 320 336z" />
                    </svg>
                    <span class="visually-hidden">Menu</span>
                </a>
            </div>
        </nav>

        <nav class="navbar navbar-dark bottom-navbar" aria-label="Primary navigation">
            <div class="container-fluid">
                <ul class="navbar-nav flex-row justify-content-around w-100 text-center">
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Sermons" asp-action="Index" aria-label="Go to Sermons">
                            <img src="~/images/sermons.svg" alt="" aria-hidden="true" />
                            <span>Sermons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Events" asp-action="Index" aria-label="Go to Events">
                            <img src="~/images/events.svg" alt="" aria-hidden="true" />
                            <span>Events</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Connect" asp-action="Index" aria-label="Go to Connect">
                            <img src="~/images/connect.svg" alt="" aria-hidden="true" />
                            <span>Connect</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Give" asp-action="Index" aria-label="Go to Give">
                            <img src="~/images/give.svg" alt="" aria-hidden="true" />
                            <span>Give</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container page-shell">
        <main id="main-content" role="main" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
