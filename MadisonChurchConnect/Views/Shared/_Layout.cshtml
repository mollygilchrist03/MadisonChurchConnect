<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MadisonChurchConnect.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- top navbar -->
        <nav class="navbar navbar-dark top-icon-bar">
            <div class="container-fluid justify-content-lg-center">
                <a class="navbar-brand" asp-area="" asp-controller="Sermons" asp-action="Index">
                    <img src="~/images/m-logo-new-white.png" alt="Madison Church Logo" height="40" width="40"/> 
                </a>
            </div>
        </nav>

        <!-- bottom navbar -->
        <nav class="navbar navbar-dark bottom-navbar">
            <div class="container-fluid">
                <ul class="navbar-nav flex-row justify-content-around w-100 text-center">
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Sermons" asp-action="Index">
                            <img src="~/images/sermons.svg" alt="Sermons" />
                            <span>Sermons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Events" asp-action="Index">
                            <img src="~/images/events.svg" alt="Events" />
                            <span>Events</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Connect" asp-action="Index">
                            <img src="~/images/connect.svg" alt="Connect" />
                            <span>Connect</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-link" asp-area="" asp-controller="Give" asp-action="Index">
                            <img src="~/images/give.svg" alt="Give" />
                            <span>Give</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>