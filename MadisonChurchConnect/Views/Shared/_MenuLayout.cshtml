<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Madison Church Connect</title>
    <meta name="description" content="Madison Church Connect account, notes, and support views in an installable Progressive Web App." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MadisonChurchConnect.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="/m-logo-new-white.ico">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="var(--mc-primary)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Madison Connect">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <script>
        (function () {
            const themeStorageKey = 'madison-connect-theme';
            const darkThemeName = 'dark';
            const lightThemeName = 'light';

            function getStoredTheme() {
                try {
                    return window.localStorage.getItem(themeStorageKey);
                } catch {
                    return null;
                }
            }

            const storedTheme = getStoredTheme();
            const preferredTheme = storedTheme === darkThemeName || storedTheme === lightThemeName
                ? storedTheme
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? darkThemeName : lightThemeName);

            document.documentElement.setAttribute('data-theme', preferredTheme);
        })();
    </script>
</head>
<body class="menu-layout-body">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div id="app-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="container page-shell page-shell-fixed">
        <main id="main-content" role="main" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
