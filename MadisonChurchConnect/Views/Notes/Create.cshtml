@model MadisonChurchConnect.Models.ViewModels.NoteViewModel

@{
    ViewData["Title"] = "Create Note";
}

<div class="container notes-page">
    <h1 class="page-title">Create New Note</h1>

    <div class="note-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="NoteTitle" class="form-label fw-semibold">Note Title</label>
                <input asp-for="NoteTitle" class="form-control" placeholder="Enter note title" />
                <span asp-validation-for="NoteTitle" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NoteDate" class="form-label fw-semibold">Date</label>
                <input asp-for="NoteDate" class="form-control" type="date" />
                <span asp-validation-for="NoteDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NoteContent" class="form-label fw-semibold">Note Content</label>
                <textarea asp-for="NoteContent" class="form-control" rows="12" placeholder="Enter note content"></textarea>
                <span asp-validation-for="NoteContent" class="text-danger"></span>
            </div>

            <div class="note-actions mt-4">
                <button type="submit" class="create-note-btn" style="color: #FEFEFA; width: auto; padding: 0.75rem 2rem;">
                    Create Note
                </button>
                <a asp-action="Index" class="create-note-btn" style="color: #FEFEFA; width: auto; padding: 0.75rem 2rem; text-decoration: none;">
                    Back to Notes
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
