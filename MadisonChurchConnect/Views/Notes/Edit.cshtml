@model MadisonChurchConnect.Models.ViewModels.NoteViewModel

@{
    ViewData["Title"] = "Edit Note";
    Layout = "_MenuLayout";
}

<div class="auth-page">
    <div class="note-card">
        <h2 class="page-title">Edit Note</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="NoteId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NoteTitle" class="form-label">Note Title</label>
                <input asp-for="NoteTitle" class="form-control" placeholder="Note Title" />
                <span asp-validation-for="NoteTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NoteDate" class="form-label">Date</label>
                <input asp-for="NoteDate" class="form-control" type="date" />
                <span asp-validation-for="NoteDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NoteContent" class="form-label">Note Content</label>
                <textarea asp-for="NoteContent" class="form-control" rows="10" placeholder="Your notes..."></textarea>
                <span asp-validation-for="NoteContent" class="text-danger"></span>
            </div>

            <div class="note-actions">
                <button type="submit" class="btn-note-action">Save Changes</button>
                <a asp-action="Index" class="btn-note-action btn-note-cancel" style="text-align:center; text-decoration: none;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
    <a asp-action="Index" class="auth-back-link">Back to Notes</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}