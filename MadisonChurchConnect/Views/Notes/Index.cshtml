@model IEnumerable<MadisonChurchConnect.Models.ViewModels.NoteViewModel>

@{
    ViewData["Title"] = "Sermon Notes";
    Layout = "_MenuLayout";
}

<div class="notes-page" style="height: 100vh; display: flex; flex-direction: column; overflow: hidden;">
    <div class="container" style="max-width: 550px; margin: 0 auto; padding: 15px; display: flex; flex-direction: column; height: 100%;">

        @* --- Fixed Header Section --- *@
        <h2 class="page-title text-center">My Sermon Notes</h2>

        <div class="create-note-section">
            <a asp-controller="Notes" asp-action="Create" class="create-note-btn shadow-sm">
                <img src="~/images/plus-solid-full.svg" alt="Create" class="btn-icon" />
                <span>Create New Note</span>
            </a>
        </div>
        @* ---------------------------- *@

        @* --- Scrollable List Section --- *@
        <div class="notes-list" style="flex: 1; overflow-y: auto; padding-right: 5px; -webkit-overflow-scrolling: touch;">
            @if (Model != null && Model.Any())
            {
                foreach (var note in Model)
                {
                    <div class="note-card-wrapper mb-3 shadow-sm">
                        <div class="note-card">
                            <a asp-controller="Notes" asp-action="Delete" asp-route-id="@note.NoteId" class="btn-delete-corner">
                                <img src="~/images/trash-can-solid-full.svg" alt="Delete" class="delete-icon" />
                            </a>

                            <a asp-controller="Notes" asp-action="Edit" asp-route-id="@note.NoteId" class="note-card-clickable">
                                <div class="note-content-wrapper">
                                    <h3 class="note-title">@note.NoteTitle</h3>
                                    <span class="note-date">@note.NoteDate.ToString("MMM dd, yyyy")</span>
                                    <p class="note-preview">
                                        @(note.NoteContent.Length > 100 ? note.NoteContent.Substring(0, 100) + "..." : note.NoteContent)
                                    </p>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="note-card empty-state shadow-sm" style="border-style: dashed; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 20px;">
                    <img src="~/images/file-regular-full.svg" alt="No notes" class="empty-icon" style="width: 50px; margin-bottom: 15px; opacity: 0.5;" />
                    <h5 style="margin-bottom: 10px;">No notes found</h5>
                    <p style="margin: 0;">Tap the button above to start your first sermon note!</p>
                </div>
            }
        </div>
        @* ------------------------------- *@

        @* --- Fixed Footer Link --- *@
        <div class="text-center mt-3 pb-2">
            <a asp-controller="Menu" asp-action="Index" class="auth-back-link">
                <i class="fas fa-chevron-left me-1"></i> Back to Menu
            </a>
        </div>
    </div>
</div>