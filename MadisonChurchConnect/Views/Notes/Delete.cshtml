@model MadisonChurchConnect.Models.ViewModels.NoteViewModel

@{
    ViewData["Title"] = "Delete Note";
    Layout = "_MenuLayout";
}

<div class="auth-page auth-page-centered">
    <div class="note-card">
        <h2 class="page-title note-delete-title">Delete Note?</h2>
        <p class="mb-4">Are you sure you want to permanently delete <strong>"@Model.NoteTitle"</strong>?</p>

        <div class="note-delete-preview">
            <small class="note-delete-date">@Model.NoteDate.ToString("MMM dd, yyyy")</small>
            <p class="note-delete-content">
                @(Model.NoteContent.Length > 150 ? Model.NoteContent.Substring(0, 150) + "..." : Model.NoteContent)
            </p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="NoteId" />
            <div class="note-actions">
                <button type="submit" class="btn-note-action note-delete-button">Yes, Delete</button>
                <a asp-action="Index" class="btn-note-action btn-note-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>
