@model MadisonChurchConnect.Models.ViewModels.NoteViewModel

@{
    ViewData["Title"] = "Delete Note";
    Layout = "_MenuLayout";
}

<div class="auth-page">
    <div class="note-card">
        <h2 class="page-title" style="color: var(--mc-danger);">Delete Note?</h2>
        <p class="mb-4">Are you sure you want to permanently delete <strong>"@Model.NoteTitle"</strong>?</p>

        <div style="background: rgba(0,0,0,0.05); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <small class="text-muted">@Model.NoteDate.ToString("MMM dd, yyyy")</small>
            <p style="font-style: italic; font-size: 0.9rem;">
                @(Model.NoteContent.Length > 150 ? Model.NoteContent.Substring(0, 150) + "..." : Model.NoteContent)
            </p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="NoteId" />
            <div class="note-actions">
                <button type="submit" class="btn-note-action" style="background-color: var(--mc-danger);">Yes, Delete</button>
                <a asp-action="Index" class="btn-note-action" style="background-color: var(--mc-secondary); text-align:center; text-decoration: none;">Cancel</a>
            </div>
        </form>
    </div>
</div>