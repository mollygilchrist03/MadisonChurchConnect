@{
    ViewData["Title"] = "Menu";
    Layout = "_MenuLayout";
}

<div class="more-page">
    <button class="menu-back-btn" id="menu-back-btn" type="button" aria-label="Back to home">
        <img src="~/images/angle-down-solid-full.svg" alt="" aria-hidden="true" class="menu-back-icon" />
    </button>

    <div class="logo-text-header">
        <div class="icon-header">
            <img src="~/images/m-logo-new-white.png" alt="Madison Church logo" />
        </div>
        <p>Madison Church</p>
    </div>

    <div class="more-section-label">Account</div>
    <div class="more-section">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-controller="Notes" asp-action="Index" class="more-row">
                <img src="~/images/file-lines-regular-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
                <span>My Notes</span>
                <span class="more-row-chevron" aria-hidden="true">›</span>
            </a>
            <div class="more-row-divider"></div>
            <form asp-controller="Login" asp-action="Logout" method="post">
                <button type="submit" class="more-row more-row-btn">
                    <img src="~/images/right-to-bracket-solid-full.svg" alt="" aria-hidden="true" class="more-row-icon icon-flip" />
                    <span>Log Out</span>
                    <span class="more-row-chevron" aria-hidden="true">›</span>
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Login" asp-action="Login" class="more-row">
                <img src="~/images/right-to-bracket-solid-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
                <span>Log In</span>
                <span class="more-row-chevron" aria-hidden="true">›</span>
            </a>
            <div class="more-row-divider"></div>
            <a asp-controller="Register" asp-action="Register" class="more-row">
                <img src="~/images/person-circle-plus-solid-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
                <span>Create Account</span>
                <span class="more-row-chevron" aria-hidden="true">›</span>
            </a>
            <div class="more-row-divider"></div>
            <a asp-controller="Login" asp-action="Login" class="more-row more-row-disabled" aria-describedby="notes-login-required">
                <img src="~/images/file-lines-regular-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
                <span>My Notes</span>
                <span class="more-row-note" id="notes-login-required">Login required</span>
            </a>
        }
    </div>

    <div class="more-section-label">General</div>
    <div class="more-section">
        <a asp-controller="Feedback" asp-action="Index" class="more-row">
            <img src="~/images/comment-dots-solid-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
            <span>Send Feedback</span>
            <span class="more-row-chevron" aria-hidden="true">›</span>
        </a>
        <div class="more-row-divider"></div>
        <a href="#" class="more-row" id="share-link">
            <img src="~/images/share-nodes-solid-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
            <span>Share App</span>
            <span class="more-row-chevron" aria-hidden="true">›</span>
        </a>
        <div class="more-row-divider"></div>
        <a href="https://www.youversion.com/bible-app" class="more-row" target="_blank" rel="noopener noreferrer">
            <img src="~/images/book-bible-solid-full (1).svg" alt="" aria-hidden="true" class="more-row-icon" />
            <span>YouVersion Bible App</span>
            <span class="more-row-chevron" aria-hidden="true">›</span>
        </a>
    </div>

    <div class="more-section-label">About</div>
    <div class="more-section">
        <div class="more-row more-row-static">
            <img src="~/images/circle-info-solid-full.svg" alt="" aria-hidden="true" class="more-row-icon" />
            <span>Version</span>
            <span class="more-row-value">
                @System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString()
            </span>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('share-link').addEventListener('click', async function (e) {
            e.preventDefault();
            const announceStatus = window.MadisonConnect?.announceStatus;
            if (navigator.share) {
                await navigator.share({
                    title: 'Madison Church App',
                    text: 'Check out the Madison Church app!',
                    url: window.location.origin
                });
                announceStatus?.('Share sheet opened.');
            } else {
                await navigator.clipboard.writeText(window.location.origin);
                announceStatus?.('App link copied to clipboard.');
            }
        });

        document.getElementById('menu-back-btn').addEventListener('click', function () {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (prefersReducedMotion) {
                window.location.href = '/';
                return;
            }

            document.body.classList.add('slide-down');

            document.body.addEventListener('animationend', function () {
                window.location.href = '/';
            }, { once: true });
        });
    </script>
}
