@{
    ViewData["Title"] = "Feedback";
    Layout = "_MenuLayout";
}
<div class="auth-page auth-page-centered">
    <div class="note-card">
        <div id="feedback-form-area">
            <h1 class="page-title">Send Feedback</h1>
            <p style="color: var(--mc-text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">
                Have a suggestion or found something wrong? Let us know!
            </p>
            <div id="feedback-error" class="text-danger mb-3" role="alert" hidden></div>
            <div class="mb-3">
                <label class="form-label" for="feedback-name">Name</label>
                <input type="text" class="form-control" placeholder="Your name" id="feedback-name" autocomplete="name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="feedback-email">Email</label>
                <input type="email" class="form-control" placeholder="Your email" id="feedback-email" autocomplete="email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="feedback-message">Message</label>
                <textarea class="form-control" rows="5" placeholder="Your feedback..." id="feedback-message"></textarea>
            </div>
            <div class="note-actions">
                <button class="btn-note-action" id="feedback-submit" type="button">Send Feedback</button>
            </div>
        </div>
        <div id="feedback-confirmation" style="display: none; text-align: center; padding: 1.5rem 0;" role="status" aria-live="polite">
            <p style="font-size: 1.5rem; margin-bottom: 0.5rem;" aria-hidden="true">✓</p>
            <h2 style="color: var(--mc-primary); margin-bottom: 0.5rem;">Thanks for your feedback!</h2>
            <p style="color: var(--mc-text-muted); font-size: 0.9rem;">
                Your message has been sent successfully.
            </p>
        </div>
    </div>
    <a asp-controller="Menu" asp-action="Index" class="auth-back-link">
        Back to Menu
    </a>
</div>

@section Scripts {
    <script>
        document.getElementById('feedback-submit').addEventListener('click', async function () {
            const name = document.getElementById('feedback-name').value.trim();
            const email = document.getElementById('feedback-email').value.trim();
            const message = document.getElementById('feedback-message').value.trim();
            const errorRegion = document.getElementById('feedback-error');
            const announceStatus = window.MadisonConnect?.announceStatus;

            errorRegion.hidden = true;
            errorRegion.textContent = '';

            if (!name || !email || !message) {
                errorRegion.hidden = false;
                errorRegion.textContent = 'Please fill out all fields before submitting.';
                announceStatus?.(errorRegion.textContent);
                return;
            }

            const btn = document.getElementById('feedback-submit');
            btn.disabled = true;
            btn.textContent = 'Sending...';
            announceStatus?.('Sending feedback.');

            try {
                const response = await fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        access_key: '4ee5cd2d-ce7e-4508-a519-e9db49cfcc40',
                        subject: 'Madison Church App Feedback',
                        name: name,
                        email: email,
                        message: message
                    })
                });

                const result = await response.json();

                if (result.success) {
                    document.getElementById('feedback-form-area').style.display = 'none';
                    document.getElementById('feedback-confirmation').style.display = 'block';
                    announceStatus?.('Feedback sent successfully.');
                } else {
                    errorRegion.hidden = false;
                    errorRegion.textContent = result.message || 'Failed to send. Please try again.';
                    announceStatus?.(errorRegion.textContent);
                    btn.disabled = false;
                    btn.textContent = 'Send Feedback';
                }
            } catch {
                errorRegion.hidden = false;
                errorRegion.textContent = 'Something went wrong. Please try again.';
                announceStatus?.(errorRegion.textContent);
                btn.disabled = false;
                btn.textContent = 'Send Feedback';
            }
        });
    </script>
}
